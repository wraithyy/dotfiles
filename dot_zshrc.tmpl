# tmux + tmuxp + fzf workflow
_tmux_goto() {
  local target="$1"
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "=$target"
    return $?
  fi
  if ! tmux attach-session -t "=$target"; then
    print -u2 "[tmux] attach failed for '$target'"
    print -u2 "  TMUX='$TMUX'  TTY=$(tty)  TERM=$TERM"
    print -u2 "  tmux: $(command -v tmux) ($(tmux -V))"
    print -u2 "  hint: stale server? zkus: tmux kill-server && work"
    return 1
  fi
}

_t_gen_lines() {
  local dim=$'\e[2m' reset=$'\e[0m'
  local sess_cwd
  sess_cwd=$(tmux list-panes -a -F '#{session_name}|#{pane_current_path}' 2>/dev/null \
             | awk -F'|' '!seen[$1]++ {print}')
  if [[ -n "$sess_cwd" ]]; then
    printf '%s\n' "${dim}── running sessions ──${reset}"
    while IFS='|' read -r s cwd; do
      cwd="${cwd/#$HOME/~}"
      printf '🟢 %-20s %s→ %s%s\n' "$s" "$dim" "$cwd" "$reset"
    done <<< "$sess_cwd"
    printf '\n'
  fi

  if command -v tmuxp >/dev/null && [[ -d "$HOME/.config/tmuxp" ]]; then
    local tpls=("$HOME/.config/tmuxp/"*.yaml(N))
    if (( ${#tpls} )); then
      printf '%s\n' "${dim}── templates ──${reset}"
      local fname dname
      for f in $tpls; do
        fname="$(basename "${f%.yaml}")"
        dname="$(awk '/^display_name:/ {gsub(/"/,""); sub(/^display_name: */,""); print; exit}' "$f" 2>/dev/null)"
        printf '🧩 %s|%s\n' "${dname:-$fname}" "$fname"
      done
      printf '\n'
    fi
  fi

  printf '%s\n' "${dim}── new ──${reset}"
  printf '➕ new (empty session)\n'
}

t() {
  command -v fzf >/dev/null || { echo "fzf missing"; return 1; }

  local reload_cmd="zsh -c 'source $HOME/.zshrc 2>/dev/null; _t_gen_lines'"

  local sel
  sel=$(_t_gen_lines | fzf --ansi \
    --delimiter '|' \
    --with-nth 1 \
    --layout=reverse \
    --prompt='tmux ❯ ' \
    --header='enter=pick · x=kill · esc=cancel' \
    --bind "x:execute-silent(
      sel={}
      [[ \"\$sel\" != \"🟢 \"* ]] && exit 0
      name=\"\${sel#🟢 }\"; name=\"\${name%% *}\"
      tmux kill-session -t \"=\$name\" 2>/dev/null
    )+reload($reload_cmd)" \
    --preview '
      sel={}
      case "$sel" in
        "🟢 "*)
          name="${sel#🟢 }"; name="${name%% *}"
          printf "\033[1m  %s\033[0m\n\n" "$name"
          tmux list-panes -t "=$name" -F "#{window_index}|#{window_name}|#{?window_active,●,·}|#{pane_current_path}" 2>/dev/null \
            | awk -F"|" "!seen[\$1]++ {path=\$4; sub(ENVIRON[\"HOME\"],\"~\",path); printf \"  %s  %-20s  %s\n\", \$3, \$2, path}"
          ;;
        "🧩 "*)
          tpl="${sel#*|}"; tpl="${tpl%% *}"
          f="$HOME/.config/tmuxp/${tpl}.yaml"
          if command -v bat &>/dev/null; then bat --color=always --style=plain "$f"
          else cat "$f"; fi ;;
        "➕ "*) printf "\n  New empty session\n  in %s\n" "$PWD" ;;
        *) ;;
      esac' \
    --preview-window=right:60%) || return

  case "$sel" in
    "🟢 "*)
      local name="${sel#🟢 }"; name="${name%% *}"
      _tmux_goto "$name"
      ;;
    "🧩 "*)
      local tpl_file; tpl_file="${sel#*|}"
      local default_name; default_name="$(basename "$PWD")"
      local sname
      read -r "sname?Session name [${default_name}]: " </dev/tty
      sname="${sname:-$default_name}"
      if ! tmux has-session -t "=$sname" 2>/dev/null; then
        tmuxp load "$tpl_file" -s "$sname" -d || return 1
      fi
      _tmux_goto "$sname"
      ;;
    "➕ "*)
      local default_name; default_name="$(basename "$PWD")"
      local ename
      read -r "ename?Session name [${default_name}]: " </dev/tty
      ename="${ename:-$default_name}"
      if ! tmux has-session -t "=$ename" 2>/dev/null; then
        tmux new-session -d -s "$ename" || return 1
      fi
      _tmux_goto "$ename"
      ;;
    *) return 0 ;;
  esac
}

work() {
  command -v tmuxp >/dev/null || { echo "tmuxp missing"; return 1; }
  local name="work-$(basename "$PWD")"
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmuxp load dev -s "$name" -d || return 1
  fi
  _tmux_goto "$name"
}

# cc: Claude Code, always in tmux. Reuses a session already running in this
# cwd (new window); starts a fresh session otherwise. No tmux -> plain claude.
cc() {
  command -v tmux >/dev/null || { claude "$@"; return; }

  if [[ -n "$TMUX" ]]; then
    tmux new-window -c "$PWD" claude
    return
  fi

  local sess
  sess=$(tmux list-panes -a -F '#{session_name}|#{pane_current_path}' 2>/dev/null \
         | awk -F'|' -v d="$PWD" '$2==d {print $1; exit}')

  if [[ -n "$sess" ]]; then
    tmux new-window -t "$sess" -c "$PWD" claude
    _tmux_goto "$sess"
    return
  fi

  local name; name="$(basename "$PWD")"
  # ponytail: basename collisions get a numeric suffix; upgrade to a
  # path-hash name if that ever actually collides in practice.
  local n="$name" i=2
  while tmux has-session -t "=$n" 2>/dev/null; do n="$name-$((i++))"; done
  tmux new-session -d -s "$n" -c "$PWD" claude
  _tmux_goto "$n"
}

# Spinner with rotating status words while a background pid runs (claude -p
# is silent until done). Writes to stderr, clears its line when finished.
_note_spin() {
  local pid=$1
  # reseed: subshells inherit parent's RANDOM state, so without this every
  # invocation replays the same word sequence
  RANDOM=$(( $(date +%s) ^ $$ ))
  local words=(
    "Přemýšlím" "Hrabu se ve vaultu" "Combobulating" "Listuji poznámkami"
    "Louskám markdown" "Dolaďuji odpověď" "Přehrabuji schůzky" "Grepuju"
    "Discombobulating" "Reticulating splines" "Konzultuji s Yodou"
    "Ptám se Gandalfa (Fly, you fools)" "One does not simply grep Mordor"
    "Hrabu se v archivech Minas Tirith" "Luštím elfí runy"
    "Otvírám bránu do Morie (mellon)" "Ent-moot v plném proudu"
    "You shall not pass… ještě moment" "Ptám se Prstenu"
    "These aren't the notes you're looking for" "Skenuji midichloriany"
    "Execute Order 66 na duplicity" "Používám Sílu. A grep. Hlavně grep."
    "Hledám v Alexandrijské knihovně" "Počítám do 42" "Don't panic, ručník mám"
    "Kouzlím s regexy" "Honím bílého králíka" "I know kung fu. A teď i tvůj vault"
    "Vstupuji do paláce mysli" "Elementary, můj milý Watsone"
    "Tetuju si to jak Leonard v Mementu" "Píšu do Death Note (klid, jen poznámky)"
    "Accio poznámko!" "Lovím vzpomínky z Myslánky"
    "Slavnostně přísahám, že hledám poznámku" "Listuju deníkem Henryho Jonese"
    "Patří to do muzea! (archivuju)" "Enhance. Enhance. ENHANCE."
    "Prohlížím 14 000 605 variant odpovědi" "Lusknu prstem a duplicity zmizí"
    "Lenochod Blesk zpracovává váš dotaz" "Třídím poznámky jak WALL-E"
    "Jdu o inbox hlouběji (BWAAAM)" "Poznámky musí proudit (spice must flow)"
    "I'll be back… s odpovědí" "Good news, everyone!"
    "Kalibruji průtokový kondenzátor" "Utahuji šroubky warp jádra"
    "Make it so" "Live long and grep" "Shall we play a game?"
    "Farmím poznámky jak XP v Azerothu" "More work? (peon souhlasí)" "Zug zug"
    "Vbíhám do vaultu — Leeroooy Jenkinsss" "Need or greed na nalezenou poznámku?"
    "Not enough minerals… grepuju dál" "Stay awhile and listen — identifikuji poznámku"
    "FUS RO DAH na ty poznámky" "Šíp do kolena, chvilku to zdrží"
    "Toss a coin to your grepper" "Čichám ke stopám jak Geralt"
    "Otvírám Vault 101" "Pip-Boy načítá záznamy"
    "Otvírám truhlu — tananananáá" "It's dangerous to go alone, grepuju s tebou"
    "Kopu hlouběji — diamanty… teda poznámky" "Optimalizuji dopravníky poznámek"
    "Roll for initiative (d20)" "Insert coin to continue"
    "Up up down down left right left right B A" "Blowing on the cartridge"
    "Achievement unlocked: Trpělivost" "Loading… (vine boom)"
    "Nikdo: … Já: grepuju vault" "This is fine (vault hoří)"
    "Stěhuju poznámky — Pivot! PIVOT!" "I am the one who knocks (na vault)"
    "Winter is coming, poznámky taky" "Ptám se Jedenáctky (nekrvácí, dobrý)"
    "Hledám to v Upside Down"
  )
  local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local i=0 w=${words[$((RANDOM % ${#words[@]} + 1))]}
  while kill -0 "$pid" 2>/dev/null; do
    # \e[K erases the rest of the line so a longer previous word leaves no tail
    printf '\r\e[2m%s %s…\e[0m\e[K' "${frames:$((i % 10)):1}" "$w" >&2
    (( ++i % 30 == 0 )) && w=${words[$((RANDOM % ${#words[@]} + 1))]}
    sleep 0.1
  done
  printf '\r\e[2K' >&2
}

# Run claude -p with a spinner when interactive; plain passthrough otherwise.
_note_claude() {
  setopt localoptions no_notify no_monitor  # no [1] 12345 / done job noise
  if [[ ! -t 1 ]]; then
    claude "$@"
    return
  fi
  local out; out=$(mktemp)
  claude "$@" > "$out" 2>&1 &
  local pid=$!
  _note_spin "$pid"
  wait "$pid"
  local rc=$?
  cat "$out"; rm -f "$out"
  return $rc
}

# note: Notes vault workflow.
#   note                open/attach notes tmux session (nvim-notes + claude)
#   note -w             the same, in a new Ghostty window
#   note <text>         instant capture to inbox/ (pure shell, no Claude)
#   note ai <text>      Claude (sonnet) files the note where it belongs
#   note ask <question> one-off Q&A over the vault (sonnet, read-only)
#   note ask -c <q>     follow-up on the previous ask conversation
note() {
  local vault=~/Development/Notes

  case "$1" in
    -w)
      open -na Ghostty --args -e zsh -ic note
      return ;;
    ask)
      shift
      local cont=()
      [[ "$1" == "-c" ]] && { cont=(--continue); shift; }
      # skip MCP servers, skills and user-level settings: ~35% faster -p start
      (cd "$vault" && _note_claude -p --model sonnet --strict-mcp-config \
        --disable-slash-commands --setting-sources project "${cont[@]}" "$*")
      return ;;
    ai)
      shift
      (cd "$vault" && _note_claude -p --model sonnet --strict-mcp-config \
        --disable-slash-commands --setting-sources project \
        --permission-mode acceptEdits --allowedTools "Bash(git:*),Bash(date:*)" \
        "Ulož tuto poznámku do vaultu na správné místo podle konvencí (projekty/lidi/poznamky; když si nejsi jistý, inbox/). Commitni a pushni. Odpověz jen cestou k souboru. Poznámka: $*")
      return ;;
    ?*)
      # instant capture, mirrors the /note skill: verbatim text, no frontmatter
      local slug
      slug=$(print -r -- "$*" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null \
             | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' \
             | sed 's/^-*//;s/-*$//' | cut -d- -f1-5)
      local file="inbox/$(date +%Y-%m-%d-%H%M)-${slug:-note}.md"
      print -r -- "$*" > "$vault/$file" || return 1
      (cd "$vault" && git add "$file" && git commit -q -m "note: ${slug:-note}" && git push -q) \
        || print -u2 "[note] saved but commit/push failed: $file"
      print "$file"
      return ;;
  esac

  command -v tmuxp >/dev/null || { echo "tmuxp missing"; return 1; }
  if ! tmux has-session -t "=notes" 2>/dev/null; then
    tmuxp load notes -d || return 1
  fi
  _tmux_goto notes
}

# Lokální config (mimo chezmoi - např. OpenClaw, secrets, machine-specific)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Powerlevel10k config
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}
