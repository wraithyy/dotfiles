# Reproducible CLI toolchain (macOS). Applied by
# run_onchange_after_install-brew-bundle.sh.tmpl via `brew bundle`.
# Linux installs its equivalents in run_once_before_install-tmuxp-bat.sh.tmpl.

# core CLI the configs assume exist
brew "neovim"
brew "tmux"
brew "tmuxp"
brew "lazygit"
brew "git-delta"       # lazygit pager (config.yml)
brew "bat"
brew "fd"
brew "ripgrep"
brew "fzf"
brew "jq"
brew "zoxide"
brew "eza"
brew "gh"              # GitHub CLI
brew "glab"            # GitLab CLI (Trask MR workflow)
brew "terminal-notifier"  # smart-notify.sh preferred backend
brew "yazi"           # y() file manager in zshrc
cask "1password-cli"  # op read for gitlab MCP token
