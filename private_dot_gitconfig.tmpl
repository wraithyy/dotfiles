[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[user]
	name = Josef
	email = {{ .email }}
	signingkey = ssh-rsa 
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
# self-signed cert on internal GitLab; scoped to that host only, not global
[http "https://gitlab.trask.cz"]
	sslVerify = false
