{
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "skills": ["!{{ .chezmoi.homeDir }}/.agents/skills/**"],
  "packages": ["npm:context-mode@1.0.169", "npm:@tintinweb/pi-subagents@0.19.0", "npm:@narumitw/pi-plan-mode@0.58.3", "npm:@juicesharp/rpiv-ask-user-question@2.11.0", "npm:pi-powerline-footer@0.17.2", "npm:@narumitw/pi-usage@0.61.0", "npm:@gotgenes/pi-permission-system@33.0.8", "npm:pi-lens@4.2.1", "git:github.com/obra/superpowers@5bf4e78011075bcfc0dc295f0724994cd123ee71", "npm:pi-goal-x@0.31.8", "npm:pi-fovea@0.31.1"],
  "powerline": {
    "preset": "default",
    "welcome": false,
    "separator": "powerline-thin",
    "path": {
      "mode": "abbreviated"
    },
    "model": {
      "display": "name"
    },
    "cost": {
      "subscriptionDisplay": "subscription",
      "currency": "USD"
    },
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "git"
      ],
      "right": [
        "context_pct",
        "cache_read",
        "time_spent",
        "custom:usage"
      ],
      "secondary": [
        "subagents",
        "custom:plan",
        "extension_statuses"
      ]
    },
    "customItems": [
      {
        "id": "usage",
        "statusKey": "usage",
        "selfColorize": true
      },
      {
        "id": "plan",
        "statusKey": "plan-mode",
        "color": "#ffe66d"
      },
      {
        "id": "lsp",
        "statusKey": "pi-lens-lsp"
      }
    ],
    "disabledSegments": [
      "custom:lsp"
    ],
    "cache_read": {
      "format": "percent"
    }
  }
}
