{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "disabledMcpjsonServers": ["context-mode"],
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:anthropic.com)",
      "mcp__time_time_get-current-time",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__context-mode__*",
      "mcp__chrome-devtools__*",
      "mcp__playwright__*",
      "mcp__webclaw__*",
      "mcp__browser-mcp__*",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(npx eslint:*)",
      "Bash(pnpm install)",
      "Bash(pnpm run *:*)",
      "Bash(pnpm test *:*)",
      "Bash(pnpm tsc *:*)",
      "Bash(npm run *:*)",
      "Bash(npx tsc:*)",
      "Bash(npx biome *:*)",
      "Bash(npx prettier *:*)",
      "Bash(npx vitest *:*)",
      "Bash(npx playwright *:*)",
      "Bash(npx knip:*)",
      "Bash(npx depcheck:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux list-panes:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin +*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)"
    ],
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "hooks": {
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/op-preflight.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/smart-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-sensitive-files.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-sensitive-files.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-doc-spam.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/smart-notify.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/fe-post-edit.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/fe-post-edit.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/fe-post-edit.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/smart-notify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/stop-verify.sh",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "command -v ccstatusline >/dev/null 2>&1 && ccstatusline || npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "caveman@caveman": true,
    "companion@companion": true,
    "context-mode@context-mode": true,
    "context7@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gitlab@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "understand-anything@understand-anything": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "companion": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/Development/companion"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "trask-skynet": {
      "source": {
        "source": "git",
        "url": "https://gitlab.trask.cz/PO/skynet.git"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "effortLevel": "medium",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
  "theme": "custom:wraithy-mocha"
}
