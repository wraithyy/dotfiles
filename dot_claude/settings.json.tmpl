{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "{{- $mods := list -}}{{- range glob (joinPath .chezmoi.sourceDir "dot_claude/mods/*") -}}{{- $mods = append $mods (printf "~/.claude/mods/%s" (base .)) -}}{{- end -}}{{ join ":" $mods }}"
  },
  "disabledMcpjsonServers": ["context-mode"],
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:anthropic.com)",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__context-mode__*",
      "mcp__chrome-devtools__*",
      "mcp__playwright__*",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(npx eslint:*)",
      "Bash(pnpm install)",
      "Bash(pnpm run *:*)",
      "Bash(pnpm test *:*)",
      "Bash(pnpm tsc *:*)",
      "Bash(npm run *:*)",
      "Bash(npx tsc:*)",
      "Bash(npx biome *:*)",
      "Bash(npx prettier *:*)",
      "Bash(npx vitest *:*)",
      "Bash(npx playwright *:*)",
      "Bash(npx knip:*)",
      "Bash(npx depcheck:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux list-panes:*)",
      "Bash(herdr pane list:*)",
      "Bash(herdr pane read:*)",
      "Bash(herdr agent list:*)",
      "Bash(herdr workspace list:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(yarn typecheck:*)",
      "Bash(pnpm vitest:*)",
      "Bash(npm view:*)",
      "Bash(chezmoi diff:*)",
      "Bash(adb devices:*)",
      "Bash(herdr --default-config:*)",
      "Bash(claude mcp list:*)"
    ],
    "ask": [],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin +*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/session-lint.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/op-preflight.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{ .chezmoi.homeDir }}/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/smart-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_context-mode_context-mode__.*|mcp__context-mode__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"context-mode sandbox tools auto-allowed (also in plan mode)\"}}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-sensitive-files.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-sensitive-files.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/ask-git-remote.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__gitlab__(create_merge_request|merge_merge_request|approve_merge_request|push_files|create_or_update_file|delete_branch)",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/ask-git-remote.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/live-edit-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-doc-spam.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/smart-notify.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pixtuoid-hook >/dev/null 2>&1 && pixtuoid-hook || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/smart-notify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/stop-verify.sh",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/verify-claims.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "command -v ccstatusline >/dev/null 2>&1 && ccstatusline || npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "caveman@caveman": true,
    "cc-guard@cc-guard": true,
    "cc-plugin-you-should-know@builtin": true,
    "i-have-adhd@i-have-adhd": true,
    "context-mode@context-mode": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gitlab@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "understand-anything@understand-anything": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "cc-guard": {
      "source": {
        "source": "github",
        "repo": "wraithyy/cc-guard"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "trask-skynet": {
      "source": {
        "source": "git",
        "url": "https://gitlab.trask.cz/PO/skynet.git"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "language": "Czech",
  "model": "opus",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "custom:wraithy-mocha",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
